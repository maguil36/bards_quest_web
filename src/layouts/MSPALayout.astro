---
import BaseLayout from './BaseLayout.astro';
import { pageConfigs, defaultPageConfig } from '../components/SpriteConfig.astro';
import { getDefaultTheme } from '../components/ThemeConfig.astro';
import { getCharacterGristAtPage, gristOrder, gristIconPaths, setPageGrist } from '../sprites/blood';

const { title = 'Bards Quest', description = 'Portable archives.', canonical, page = 1 } = Astro.props;

// Get theme config for this page (assuming chapter 1)
const themeConfig = getDefaultTheme(1, typeof page === 'number' ? page : 1);

const navItems = [
  { label: 'BARDS QUEST', href: '/' },
  { label: 'XTWITTER', href: 'https://x.com', external: true },
  { label: 'NEWS', href: '/news' },
  { label: 'GITHUB', href: 'https://github.com/maguil36/bards_quest_web', external: true },
  { label: 'MAP', href: '/map' },
  { label: 'PATREON', href: 'https://patreon.com', external: true },
  { label: 'MUSIC', href: '#' },
  { label: 'OPTIONS', href: '/options' },
  { label: 'WIKI', href: '#', external: true },  // placeholder link removed actual mspaintadventures wiki link
  { label: 'CREDITS', href: '#' },
];
---
<BaseLayout title={title} description={description} canonical={canonical} showHeader={false} showFooter={false} bodyClass="mspa">
  <script slot="head" define:vars={{ themeConfigStr: themeConfig ? JSON.stringify(themeConfig) : 'null' }}>
    // This runs AFTER BaseLayout's script to override theme if needed
    (function() {
      const pageThemeConfig = themeConfigStr !== 'null' ? JSON.parse(themeConfigStr) : null;
      const userTheme = (function(){ try { return localStorage.getItem('mspa:theme'); } catch { return null; } })();

      if (pageThemeConfig) {
        const shouldApplyPageTheme = pageThemeConfig.overrule || !userTheme || userTheme === 'default';

        if (shouldApplyPageTheme) {
          const targetTheme = pageThemeConfig.theme;
          const originalTheme = pageThemeConfig.originalTheme;
          const transition = pageThemeConfig.transition || 'smooth';

          // For scroll/crawl transitions, start with originalTheme
          if ((transition === 'crawl' || transition === 'scroll') && originalTheme) {
            document.documentElement.setAttribute('data-theme', originalTheme);
          } else {
            document.documentElement.setAttribute('data-theme', targetTheme);
          }
          document.documentElement.setAttribute('data-transition', 'instant');
        }
      }
    })();
  </script>
  <slot name="head" slot="head" />
  <main class="wrap">
    <nav class="mspa-nav">
      {navItems.map((item, i) => (
        <span class="mspa-nav-item">
          {i !== 0 && <span class="dot">•</span>}
          {item.external ? (
            <a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </span>
      ))}
    </nav>

    <section class="mspa-card">
      <div class="panel">
        <slot />
      </div>
    </section>

    <footer class="mspa-footer">
      <p>© 2025 - {new Date().getFullYear()} Bards Quest</p>
      <p><a href="/privacy">Privacy</a> – <a href="/legal">Legal</a></p>
    </footer>

    <div id="left-sprite-container" class="sprite left"></div>
    <img src="/images/aspects/breath.svg" alt="aspect symbol" class="sprite right" id="aspect-sprite" />
  </main>

  <script define:vars={{ pageConfigs: JSON.stringify(pageConfigs), defaultPageConfig: JSON.stringify(defaultPageConfig), currentPage: page, themeConfig: JSON.stringify(themeConfig), gristOrderData: JSON.stringify(gristOrder), gristIconPathsData: JSON.stringify(gristIconPaths) }}>
    const configs = JSON.parse(pageConfigs)[currentPage] || JSON.parse(defaultPageConfig) || {};
    const pageThemeConfig = themeConfig ? JSON.parse(themeConfig) : null;
    const gristOrder = JSON.parse(gristOrderData);
    const gristIconPaths = JSON.parse(gristIconPathsData);

    console.log('Current page:', currentPage);
    console.log('Loaded configs:', configs);
    console.log('Space config specifically:', configs.space);

    // Preload all grist data from all pages for all characters
    function preloadAllGristData() {
      const allConfigs = JSON.parse(pageConfigs);
      for (const [page, pageConfig] of Object.entries(allConfigs)) {
        if (pageConfig.blood && pageConfig.blood.type === 'grist') {
          const character = pageConfig.blood.character || pageConfig.pov || 'alexis';
          const pageNum = parseInt(page);
          const deltas = pageConfig.blood.deltas;

          if (deltas && Object.keys(deltas).length > 0) {
            setPageGrist(character, pageNum, deltas);
          }
        }
      }
    }

    // Grist inventory tracking (client-side)
    const characterGristInventory = new Map();

    // Preload grist data on page load
    preloadAllGristData();

    function setPageGrist(character, pageNumber, deltas) {
      if (!characterGristInventory.has(character)) {
        characterGristInventory.set(character, new Map());
      }
      characterGristInventory.get(character).set(pageNumber, deltas);
    }

    function getCharacterGristAtPage(character, pageNumber) {
      const inventory = {};

      if (!characterGristInventory.has(character)) {
        return inventory;
      }

      const characterPages = characterGristInventory.get(character);
      const sortedPages = Array.from(characterPages.keys()).sort((a, b) => a - b);

      for (const page of sortedPages) {
        if (page > pageNumber) break;

        const deltas = characterPages.get(page);
        for (const [gristType, amount] of Object.entries(deltas)) {
          inventory[gristType] = (inventory[gristType] || 0) + amount;
        }
      }

      return inventory;
    }

    // Handle scroll-based transitions (initial theme already set in <head>)
    const userTheme = localStorage.getItem('mspa:theme');

    if (pageThemeConfig) {
      const shouldApplyTransition = pageThemeConfig.overrule || !userTheme || userTheme === 'default';

      if (shouldApplyTransition) {
        const targetTheme = pageThemeConfig.theme;
        const originalTheme = pageThemeConfig.originalTheme || 'space';
        const transition = pageThemeConfig.transition || 'smooth';

        // Only set up scroll listeners for scroll-based transitions
        if (transition === 'crawl' || transition === 'scroll') {
          function handleScrollTransition() {
            const scrollPercent = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);

            if (transition === 'scroll') {
              // Simple scroll: switch at 50%
              const newTheme = scrollPercent >= 0.5 ? targetTheme : originalTheme;
              if (document.documentElement.getAttribute('data-theme') !== newTheme) {
                document.documentElement.setAttribute('data-transition', 'smooth');
                document.documentElement.setAttribute('data-theme', newTheme);
              }
            } else if (transition === 'crawl') {
              // Crawl: transition happens at 80% scroll
              if (scrollPercent >= 0.8) {
                if (document.documentElement.getAttribute('data-theme') !== targetTheme) {
                  document.documentElement.setAttribute('data-transition', 'smooth');
                  document.documentElement.setAttribute('data-theme', targetTheme);
                }
              } else {
                if (document.documentElement.getAttribute('data-theme') !== originalTheme) {
                  document.documentElement.setAttribute('data-transition', 'smooth');
                  document.documentElement.setAttribute('data-theme', originalTheme);
                }
              }
            }
          }

          window.addEventListener('scroll', handleScrollTransition, { passive: true });
          handleScrollTransition(); // Check initial position
        }
      }
    }

    let voidMessageLogged = false;

    async function updateLeftSprite() {
      const theme = document.documentElement.getAttribute('data-theme') || 'space';
      const config = configs[theme];
      const pov = configs.pov || 'alexis';
      const container = document.getElementById('left-sprite-container');

      console.log('Current theme:', theme);
      console.log('POV character:', pov);
      console.log('Config for theme:', config);
      console.log('Container element:', container);

      if (!container) return;

      if (!config) {
        console.log('No config found for theme:', theme);
        container.innerHTML = '';
        return;
      }

      if (theme === 'void' && configs.void && configs.void.message && !voidMessageLogged) {
        console.log('%c' + configs.void.message, 'color: #000080; font-style: italic;');
        voidMessageLogged = true;
      } else if (theme !== 'void') {
        voidMessageLogged = false;
      }

      if (config.type === 'clock') {
        container.innerHTML = `
          <div style="position: relative; width: 72px; height: 72px;">
            <div id="clock-date" style="position: absolute; top: -16px; left: 0; right: 0; font-size: 10px; font-weight: bold; color: #FF2106; font-family: monospace; text-align: center;"></div>
            <canvas id="clock-canvas" width="72" height="72" style="display: block;"></canvas>
          </div>
        `;
        console.log('Initializing clock with config:', config);
        initClock(config);
      } else if (config.type === 'static') {
        console.log('Rendering static sprite with SVG:', config.svg);

        // For light theme, use POV character
        if (theme === 'light') {
          const { lightCharacterPaths } = await import('../sprites/light.ts');
          const characterPath = lightCharacterPaths[pov.toLowerCase()];

          if (characterPath && config.tooltip) {
            container.innerHTML = `
              <div class="light-tooltip-container">
                <img src="${characterPath}" alt="${pov}" style="width: 72px; height: 72px;" />
                <div class="light-tooltip">${config.tooltip}</div>
              </div>
            `;
          } else {
            container.innerHTML = '';
          }
        } else if (theme === 'rage') {
          // For rage theme, use POV character's weapon
          const { characterWeapons, rageWeaponPaths } = await import('../sprites/rage.ts');
          const weaponType = characterWeapons[pov.toLowerCase()] || 'sword';
          const weaponPath = rageWeaponPaths[weaponType];

          if (weaponPath) {
            container.innerHTML = `
              <img src="${weaponPath}" alt="${weaponType}" style="width: 72px; height: 72px;" ${config.weaponName ? `title="${config.weaponName}"` : ''} />
            `;
          } else {
            container.innerHTML = '';
          }
        } else {
          // Check if the SVG contains an image href (external file reference)
          const imageHrefMatch = config.svg.match(/href=["']([^"']+)["']/);
          if (imageHrefMatch) {
            const imagePath = imageHrefMatch[1];
            console.log('Using direct image path:', imagePath);

            container.innerHTML = `
              <img src="${imagePath}" alt="sprite decoration" style="width: 72px; height: 72px;" />
            `;
          } else {
            // Use inline SVG
            container.innerHTML = `
              <img src="data:image/svg+xml;utf8,${encodeURIComponent(config.svg)}" alt="sprite decoration" />
            `;
          }
        }
      } else if (config.type === 'godtier') {
        console.log('Rendering god tier symbol for:', config);
        const aspectName = config.aspect.toLowerCase();
        container.innerHTML = `
          <img src="/images/aspects/${aspectName}.svg" alt="${config.aspect} aspect" style="width: 72px; height: 72px;" title="${config.characterName} - ${config.class} of ${config.aspect}" />
        `;
      } else if (config.type === 'healthbar') {
        console.log('Rendering health bar:', config);
        const percentage = Math.max(0, Math.min(100, (config.currentHealth / config.maxHealth) * 100));

        container.innerHTML = `
          <div style="width: 72px; height: 72px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
              <circle cx="36" cy="36" r="30" fill="none" stroke="#333" stroke-width="4"/>
              <circle cx="36" cy="36" r="30" fill="none" stroke="#72EB34" stroke-width="4"
                stroke-dasharray="${2 * Math.PI * 30}"
                stroke-dashoffset="${2 * Math.PI * 30 * (1 - percentage / 100)}"
                transform="rotate(-90 36 36)"
                stroke-linecap="round"/>
              ${config.showNumbers !== false ? `<text x="36" y="40" text-anchor="middle" font-size="10" font-weight="bold" fill="#72EB34" font-family="monospace">${config.currentHealth}/${config.maxHealth}</text>` : ''}
            </svg>
          </div>
        `;
      } else if (config.type === 'hidden') {
        container.innerHTML = '';
      } else if (config.type === 'grist') {
        console.log('Rendering grist counter:', config);

        // Use POV character if not specified in config
        const character = config.character || pov;

        // Set page grist if deltas are provided
        if (config.deltas && Object.keys(config.deltas).length > 0) {
          setPageGrist(character, config.pageNumber, config.deltas);
        }

        // Get character's current inventory at this page
        const inventory = getCharacterGristAtPage(character, config.pageNumber);

        // Filter to only grists with non-zero amounts, in order
        const availableGrists = gristOrder.filter(gristType => inventory[gristType] && inventory[gristType] > 0);

        if (availableGrists.length === 0) {
          container.innerHTML = '';
          return;
        }

        // Create grist counter UI
        const gristHTML = availableGrists.map((gristType, index) => {
          const amount = inventory[gristType];
          const iconPath = gristIconPaths[gristType];
          return `
            <div class="grist-item" data-index="${index}" data-grist="${gristType}">
              <img src="${iconPath}" alt="${gristType}" class="grist-icon" />
              <span class="grist-amount">${amount}</span>
            </div>
          `;
        }).join('');

        container.innerHTML = `
          <div class="grist-counter" id="grist-counter">
            <div class="grist-list" id="grist-list">
              ${gristHTML}
            </div>
          </div>
        `;

        // Initialize grist counter interactions after DOM is ready
        requestAnimationFrame(() => {
          initGristCounter(availableGrists.length);
        });
      } else {
        console.log('Unknown config type:', config);
        container.innerHTML = '';
      }
    }

    function initGristCounter(totalGrists) {
      const counter = document.getElementById('grist-counter');
      const list = document.getElementById('grist-list');

      console.log('Initializing grist counter with', totalGrists, 'grists');
      console.log('Counter element:', counter);
      console.log('List element:', list);

      if (!counter || !list) {
        console.log('Counter or list not found!');
        return;
      }

      let currentIndex = 0;
      let isHovering = false;
      let originalItems = [];

      // Store original items on first call
      const storeOriginalItems = () => {
        if (originalItems.length === 0) {
          originalItems = Array.from(list.querySelectorAll('.grist-item'));
        }
      };

      // Show exactly 3 items: one above, one active center, one below (infinite scroll with wrapping)
      const updateDisplay = () => {
        storeOriginalItems();
        const prevIndex = (currentIndex - 1 + totalGrists) % totalGrists;
        const nextIndex = (currentIndex + 1) % totalGrists;

        // Clear the list
        list.innerHTML = '';

        // Add items in the correct visual order: above, active (center), below
        const aboveItem = originalItems[prevIndex].cloneNode(true);
        aboveItem.classList.remove('active', 'above', 'below');
        aboveItem.classList.add('above');
        aboveItem.style.display = 'flex';
        list.appendChild(aboveItem);

        const activeItem = originalItems[currentIndex].cloneNode(true);
        activeItem.classList.remove('active', 'above', 'below');
        activeItem.classList.add('active');
        activeItem.style.display = 'flex';
        list.appendChild(activeItem);

        const belowItem = originalItems[nextIndex].cloneNode(true);
        belowItem.classList.remove('active', 'above', 'below');
        belowItem.classList.add('below');
        belowItem.style.display = 'flex';
        list.appendChild(belowItem);
      };

      counter.addEventListener('mouseenter', () => {
        console.log('Mouse entered grist counter');
        isHovering = true;
        counter.classList.add('expanded');
        updateDisplay();
        console.log('Counter classes after expand:', counter.className);
        console.log('All grist items:', list.querySelectorAll('.grist-item'));
      });

      counter.addEventListener('mouseleave', () => {
        console.log('Mouse left grist counter');
        isHovering = false;
        counter.classList.remove('expanded');
        updateDisplay();
      });

      counter.addEventListener('wheel', (e) => {
        if (!isHovering) return;
        e.preventDefault();
        console.log('Wheel event:', e.deltaY);

        if (e.deltaY < 0) {
          // Scroll up - move to previous item (items move down visually)
          currentIndex = (currentIndex - 1 + totalGrists) % totalGrists;
        } else {
          // Scroll down - move to next item (items move up visually)
          currentIndex = (currentIndex + 1) % totalGrists;
        }

        updateDisplay();
      }, { passive: false });

      updateDisplay();
      console.log('Grist counter initialized successfully');
    }

    function initClock(config) {
      const canvas = document.getElementById('clock-canvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const parseTime = (timeStr) => {
        const [h, m, s] = timeStr.split(':').map(Number);
        return h * 3600 + m * 60 + s;
      };

      const parseDate = (dateStr) => {
        const [y, m, d] = dateStr.split(':').map(Number);
        return { year: y, month: m, day: d };
      };

      const getUTCTimeInSeconds = () => {
        const now = new Date();
        return now.getUTCHours() * 3600 + now.getUTCMinutes() * 60 + now.getUTCSeconds();
      };

      const getUTCDate = () => {
        const now = new Date();
        return { year: now.getUTCFullYear(), month: now.getUTCMonth() + 1, day: now.getUTCDate() };
      };

      const getRandomTime = () => {
        return Math.floor(Math.random() * 86400);
      };

      const getRandomDate = () => {
        const year = 2000 + Math.floor(Math.random() * 50);
        const month = 1 + Math.floor(Math.random() * 12);
        const day = 1 + Math.floor(Math.random() * 28);
        return { year, month, day };
      };

      const parseTimeValue = (value, previousValue) => {
        if (value === 'NaN' || value === 'nan') {
          return NaN;
        }
        if (value === 'random') {
          return getRandomTime();
        }
        if (value.startsWith('= ')) {
          const pauseSeconds = parseInt(value.substring(2));
          return { pause: pauseSeconds, value: previousValue };
        }
        if (value.startsWith('> ')) {
          const param = value.substring(2).trim();
          if (param === 'random') {
            return { jump: true, value: getRandomTime() };
          }
          if (param === 'NaN' || param === 'nan') {
            return { jump: true, value: NaN };
          }
          const jumpSeconds = parseInt(param);
          return { jump: true, value: previousValue + jumpSeconds };
        }
        if (value.startsWith('+ ')) {
          const addSeconds = parseInt(value.substring(2));
          return previousValue + addSeconds;
        }
        return parseTime(value);
      };

      const parseDateValue = (value, previousValue) => {
        if (!value) return null;
        if (value === 'NaN' || value === 'nan') {
          return 'NaN';
        }
        if (value === 'random') {
          return getRandomDate();
        }
        if (value.startsWith('= ')) {
          const pauseDays = parseInt(value.substring(2));
          return { pause: pauseDays, value: previousValue };
        }
        if (value.startsWith('> ')) {
          const param = value.substring(2).trim();
          if (param === 'random') {
            return { jump: true, value: getRandomDate() };
          }
          if (param === 'NaN' || param === 'nan') {
            return { jump: true, value: 'NaN' };
          }
          const jumpDays = parseInt(param);
          const newDate = new Date(previousValue.year, previousValue.month - 1, previousValue.day + jumpDays);
          return { jump: true, value: { year: newDate.getFullYear(), month: newDate.getMonth() + 1, day: newDate.getDate() } };
        }
        if (value.startsWith('+ ')) {
          const addDays = parseInt(value.substring(2));
          const newDate = new Date(previousValue.year, previousValue.month - 1, previousValue.day + addDays);
          return { year: newDate.getFullYear(), month: newDate.getMonth() + 1, day: newDate.getDate() };
        }
        return parseDate(value);
      };

      const mode = config.mode || 'default';
      const speed = config.speed || 1;
      const trigger = config.trigger || 'automatic';

      let currentSeconds;
      let currentDate;
      let timeSequence = [];
      let dateSequence = [];
      let sequenceIndex = 0;
      let pauseRemaining = 0;
      let lastFrameTime = Date.now();
      let isRunning = trigger === 'automatic';

      if (mode === 'default') {
        currentSeconds = getUTCTimeInSeconds();
        currentDate = getUTCDate();
      } else {
        let prevValue = parseTimeValue(config.startTime, 0);
        if (typeof prevValue === 'object' && prevValue.pause) {
          pauseRemaining = prevValue.pause;
          currentSeconds = prevValue.value;
          timeSequence.push(prevValue.value);
          prevValue = prevValue.value;
        } else if (typeof prevValue === 'object' && prevValue.jump) {
          currentSeconds = prevValue.value;
          timeSequence.push(prevValue);
          prevValue = prevValue.value;
        } else {
          currentSeconds = prevValue;
          timeSequence.push(prevValue);
        }

        let prevDate = parseDateValue(config.startDate, getUTCDate());
        if (prevDate) {
          if (typeof prevDate === 'object' && prevDate.pause) {
            currentDate = prevDate.value;
            dateSequence.push(prevDate.value);
            prevDate = prevDate.value;
          } else if (typeof prevDate === 'object' && prevDate.jump) {
            currentDate = prevDate.value;
            dateSequence.push(prevDate);
            prevDate = prevDate.value;
          } else if (prevDate === 'NaN') {
            currentDate = 'NaN';
            dateSequence.push('NaN');
          } else {
            currentDate = prevDate;
            dateSequence.push(prevDate);
          }
        } else {
          currentDate = getUTCDate();
          dateSequence.push(currentDate);
          prevDate = currentDate;
        }

        if (config.middleTimes) {
          for (let i = 0; i < config.middleTimes.length; i++) {
            const middleTime = config.middleTimes[i];
            const parsed = parseTimeValue(middleTime, prevValue);
            if (typeof parsed === 'object' && parsed.pause) {
              timeSequence.push({ pause: parsed.pause, value: parsed.value });
              prevValue = parsed.value;
            } else if (typeof parsed === 'object' && parsed.jump) {
              timeSequence.push(parsed);
              prevValue = parsed.value;
            } else {
              timeSequence.push(parsed);
              prevValue = parsed;
            }

            if (config.middleDates && config.middleDates[i]) {
              const parsedDate = parseDateValue(config.middleDates[i], prevDate);
              if (parsedDate) {
                if (typeof parsedDate === 'object' && parsedDate.pause) {
                  dateSequence.push(parsedDate);
                  prevDate = parsedDate.value;
                } else if (typeof parsedDate === 'object' && parsedDate.jump) {
                  dateSequence.push(parsedDate);
                  prevDate = parsedDate.value;
                } else if (parsedDate === 'NaN') {
                  dateSequence.push('NaN');
                } else {
                  dateSequence.push(parsedDate);
                  prevDate = parsedDate;
                }
              } else {
                dateSequence.push(prevDate);
              }
            } else {
              dateSequence.push(prevDate);
            }
          }
        }

        const endParsed = parseTimeValue(config.endTime, prevValue);
        if (typeof endParsed === 'object' && endParsed.pause) {
          timeSequence.push(endParsed);
        } else if (typeof endParsed === 'object' && endParsed.jump) {
          timeSequence.push(endParsed);
        } else {
          timeSequence.push(endParsed);
        }

        const endDateParsed = parseDateValue(config.endDate, prevDate);
        if (endDateParsed) {
          if (typeof endDateParsed === 'object' && endDateParsed.pause) {
            dateSequence.push(endDateParsed);
          } else if (typeof endDateParsed === 'object' && endDateParsed.jump) {
            dateSequence.push(endDateParsed);
          } else if (endDateParsed === 'NaN') {
            dateSequence.push('NaN');
          } else {
            dateSequence.push(endDateParsed);
          }
        } else {
          dateSequence.push(prevDate);
        }
      }

      if (trigger === 'click') {
        canvas.style.cursor = 'pointer';
        canvas.addEventListener('click', () => {
          if (!isRunning) {
            isRunning = true;
            lastFrameTime = Date.now();
          }
        });
      }

      function drawClock() {
        ctx.clearRect(0, 0, 72, 72);

        ctx.fillStyle = '#B70D0E';
        ctx.beginPath();
        ctx.arc(36, 36, 32, 0, Math.PI * 2);
        ctx.fill();

        const dateDisplay = document.getElementById('clock-date');
        if (dateDisplay) {
          if (currentDate === 'NaN') {
            dateDisplay.textContent = '';
          } else if (currentDate && typeof currentDate === 'object') {
            const year = currentDate.year;
            const month = String(currentDate.month).padStart(2, '0');
            const day = String(currentDate.day).padStart(2, '0');
            dateDisplay.textContent = `${year}:${month}:${day}`;
          } else {
            const now = new Date();
            const year = now.getUTCFullYear();
            const month = String(now.getUTCMonth() + 1).padStart(2, '0');
            const day = String(now.getUTCDate()).padStart(2, '0');
            dateDisplay.textContent = `${year}:${month}:${day}`;
          }
        }

        if (isNaN(currentSeconds)) {
          return;
        }

        const hours = Math.floor(currentSeconds / 3600) % 24;
        const minutes = Math.floor((currentSeconds % 3600) / 60);
        const seconds = Math.floor(currentSeconds % 60);

        const drawHand = (angle, length, width) => {
          ctx.save();
          ctx.translate(36, 36);
          ctx.rotate(angle);
          ctx.strokeStyle = '#FF2106';
          ctx.lineWidth = width;
          ctx.beginPath();
          ctx.moveTo(0, 0);
          ctx.lineTo(0, -length);
          ctx.stroke();
          ctx.restore();
        };

        const hourAngle = ((hours % 12) + minutes / 60) * (Math.PI / 6);
        const minuteAngle = (minutes + seconds / 60) * (Math.PI / 30);
        const secondAngle = seconds * (Math.PI / 30);

        drawHand(hourAngle, 15, 3);
        drawHand(minuteAngle, 22, 2);
        drawHand(secondAngle, 26, 1);

        ctx.fillStyle = '#FF2106';
        ctx.beginPath();
        ctx.arc(36, 36, 3, 0, Math.PI * 2);
        ctx.fill();
      }

      function animate() {
        if (!isRunning) {
          drawClock();
          requestAnimationFrame(animate);
          return;
        }

        const now = Date.now();
        const deltaTime = (now - lastFrameTime) / 1000;
        lastFrameTime = now;

        if (mode === 'default') {
          currentSeconds = getUTCTimeInSeconds();
          currentDate = getUTCDate();
        } else {
          if (pauseRemaining > 0) {
            pauseRemaining -= deltaTime * speed;
            if (pauseRemaining <= 0) {
              pauseRemaining = 0;
              sequenceIndex++;
              if (sequenceIndex < timeSequence.length) {
                const nextValue = timeSequence[sequenceIndex];
                if (typeof nextValue === 'object' && nextValue.pause) {
                  pauseRemaining = nextValue.pause;
                  currentSeconds = nextValue.value;
                } else {
                  currentSeconds = nextValue;
                }

                if (dateSequence[sequenceIndex]) {
                  const nextDate = dateSequence[sequenceIndex];
                  if (typeof nextDate === 'object' && nextDate.pause) {
                    currentDate = nextDate.value;
                  } else if (typeof nextDate === 'object' && nextDate.jump) {
                    currentDate = nextDate.value;
                  } else {
                    currentDate = nextDate;
                  }
                }
              }
            }
          } else {
            const targetTime = timeSequence[sequenceIndex];
            const actualTarget = typeof targetTime === 'object' ? targetTime.value : targetTime;
            const isJump = typeof targetTime === 'object' && targetTime.jump;

            if (isJump) {
              currentSeconds = actualTarget;
              sequenceIndex++;

              if (sequenceIndex >= timeSequence.length) {
                if (mode === 'loop') {
                  sequenceIndex = 0;
                  const firstValue = timeSequence[0];
                  if (typeof firstValue === 'object' && firstValue.pause) {
                    pauseRemaining = firstValue.pause;
                    currentSeconds = firstValue.value;
                  } else if (typeof firstValue === 'object' && firstValue.jump) {
                    currentSeconds = firstValue.value;
                  } else {
                    currentSeconds = firstValue;
                  }

                  if (dateSequence[0]) {
                    const firstDate = dateSequence[0];
                    if (typeof firstDate === 'object' && firstDate.pause) {
                      currentDate = firstDate.value;
                    } else if (typeof firstDate === 'object' && firstDate.jump) {
                      currentDate = firstDate.value;
                    } else {
                      currentDate = firstDate;
                    }
                  }
                } else {
                  sequenceIndex = timeSequence.length - 1;
                }
              } else {
                const nextValue = timeSequence[sequenceIndex];
                if (typeof nextValue === 'object' && nextValue.pause) {
                  pauseRemaining = nextValue.pause;
                  currentSeconds = nextValue.value;
                }

                if (dateSequence[sequenceIndex]) {
                  const nextDate = dateSequence[sequenceIndex];
                  if (typeof nextDate === 'object' && nextDate.pause) {
                    currentDate = nextDate.value;
                  } else if (typeof nextDate === 'object' && nextDate.jump) {
                    currentDate = nextDate.value;
                  } else {
                    currentDate = nextDate;
                  }
                }
              }
            } else if (currentSeconds < actualTarget) {
              currentSeconds += deltaTime * speed;
              if (currentSeconds >= actualTarget) {
                currentSeconds = actualTarget;
                sequenceIndex++;

                if (sequenceIndex >= timeSequence.length) {
                  if (mode === 'loop') {
                    sequenceIndex = 0;
                    const firstValue = timeSequence[0];
                    if (typeof firstValue === 'object' && firstValue.pause) {
                      pauseRemaining = firstValue.pause;
                      currentSeconds = firstValue.value;
                    } else if (typeof firstValue === 'object' && firstValue.jump) {
                      currentSeconds = firstValue.value;
                    } else {
                      currentSeconds = firstValue;
                    }

                    if (dateSequence[0]) {
                      const firstDate = dateSequence[0];
                      if (typeof firstDate === 'object' && firstDate.pause) {
                        currentDate = firstDate.value;
                      } else if (typeof firstDate === 'object' && firstDate.jump) {
                        currentDate = firstDate.value;
                      } else {
                        currentDate = firstDate;
                      }
                    }
                  } else {
                    sequenceIndex = timeSequence.length - 1;
                  }
                } else {
                  const nextValue = timeSequence[sequenceIndex];
                  if (typeof nextValue === 'object' && nextValue.pause) {
                    pauseRemaining = nextValue.pause;
                    currentSeconds = nextValue.value;
                  }

                  if (dateSequence[sequenceIndex]) {
                    const nextDate = dateSequence[sequenceIndex];
                    if (typeof nextDate === 'object' && nextDate.pause) {
                      currentDate = nextDate.value;
                    } else if (typeof nextDate === 'object' && nextDate.jump) {
                      currentDate = nextDate.value;
                    } else {
                      currentDate = nextDate;
                    }
                  }
                }
              }
            } else if (currentSeconds >= actualTarget) {
              sequenceIndex++;

              if (sequenceIndex >= timeSequence.length) {
                if (mode === 'loop') {
                  sequenceIndex = 0;
                  const firstValue = timeSequence[0];
                  if (typeof firstValue === 'object' && firstValue.pause) {
                    pauseRemaining = firstValue.pause;
                    currentSeconds = firstValue.value;
                  } else if (typeof firstValue === 'object' && firstValue.jump) {
                    currentSeconds = firstValue.value;
                  } else {
                    currentSeconds = firstValue;
                  }

                  if (dateSequence[0]) {
                    const firstDate = dateSequence[0];
                    if (typeof firstDate === 'object' && firstDate.pause) {
                      currentDate = firstDate.value;
                    } else if (typeof firstDate === 'object' && firstDate.jump) {
                      currentDate = firstDate.value;
                    } else {
                      currentDate = firstDate;
                    }
                  }
                } else {
                  sequenceIndex = timeSequence.length - 1;
                }
              } else {
                const nextValue = timeSequence[sequenceIndex];
                if (typeof nextValue === 'object' && nextValue.pause) {
                  pauseRemaining = nextValue.pause;
                  currentSeconds = nextValue.value;
                }

                if (dateSequence[sequenceIndex]) {
                  const nextDate = dateSequence[sequenceIndex];
                  if (typeof nextDate === 'object' && nextDate.pause) {
                    currentDate = nextDate.value;
                  } else if (typeof nextDate === 'object' && nextDate.jump) {
                    currentDate = nextDate.value;
                  } else {
                    currentDate = nextDate;
                  }
                }
              }
            }
          }
        }

        drawClock();
        requestAnimationFrame(animate);
      }

      animate();
    }

    updateLeftSprite();

    window.addEventListener('theme-changed', () => {
      updateLeftSprite();
    });
  </script>

  <script>
    // Update aspect symbol based on current theme
    function updateAspectSymbol() {
      const theme = document.documentElement.getAttribute('data-theme') || 'space';
      const aspectSprite = document.getElementById('aspect-sprite') as HTMLImageElement;
      if (aspectSprite) {
        aspectSprite.src = `/images/aspects/${theme}.svg`;
        aspectSprite.alt = `${theme} aspect symbol`;
      }
    }

    // Update on page load
    updateAspectSymbol();

    // Create a MutationObserver to watch for theme changes
    const observer = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
          updateAspectSymbol();

          const event = new CustomEvent('theme-changed');
          window.dispatchEvent(event);
        }
      });
    });

    // Start observing the document element for attribute changes
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme']
    });
  </script>

  <script>
    // Listen for theme change messages from the game iframe
    window.addEventListener('message', (event) => {
      // Check if this is a theme change message from the game
      if (event.data && event.data.type === 'GAME_THEME_CHANGE') {
        const newTheme = event.data.theme;

        // Check user's theme preference from localStorage
        const themeKey = 'mspa:theme';
        let userTheme: string | null = null;
        try {
          userTheme = localStorage.getItem(themeKey);
        } catch (e) {
          // localStorage not available
        }

        // Only apply the game's theme if user has "default" or no preference
        if (!userTheme || userTheme === 'default') {
          // Get the current theme before changing
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'space';

          // Only transition if the theme is actually changing
          if (currentTheme !== newTheme) {
            // Step 1: Set transition to instant temporarily
            document.documentElement.setAttribute('data-transition', 'instant');

            // Step 2: Ensure current theme is applied
            document.documentElement.setAttribute('data-theme', currentTheme);

            // Step 3: Force a reflow to ensure the browser renders the current state
            void document.documentElement.offsetHeight;

            // Step 4: Restore smooth transition
            document.documentElement.setAttribute('data-transition', 'smooth');

            // Step 5: Use requestAnimationFrame to apply new theme on next frame
            requestAnimationFrame(() => {
              document.documentElement.setAttribute('data-theme', newTheme);
              console.log('Parent page theme smoothly transitioned to:', newTheme);
            });
          }
        }
      }
    });
  </script>
