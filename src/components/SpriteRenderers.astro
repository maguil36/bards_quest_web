<script is:inline>
  window.SpriteRenderers = {
    renderClockSprite(container, config, initClock) {
      container.innerHTML = `
        <div style="position: relative; width: 72px; height: 72px;">
          <div id="clock-date" style="position: absolute; top: -16px; left: 0; right: 0; font-size: 10px; font-weight: bold; color: #FF2106; font-family: monospace; text-align: center;"></div>
          <canvas id="clock-canvas" width="72" height="72" style="display: block;"></canvas>
        </div>
      `;
      console.log('Initializing clock with config:', config);
      initClock(config);
    },

    renderStaticSprite(container, config, theme, pov, lightCharacterPaths) {
      console.log('Rendering static sprite with SVG:', config.svg);

      if (theme === 'light') {
        const characterPath = lightCharacterPaths[pov.toLowerCase()];

        if (characterPath && config.tooltip) {
          container.innerHTML = `
            <div class="light-tooltip-container">
              <img src="${characterPath}" alt="${pov}" class="light-character-icon" />
              <span class="light-tooltip">${config.tooltip}</span>
            </div>
          `;
        } else {
          container.innerHTML = config.svg;
        }
      } else {
        container.innerHTML = config.svg;
      }
    },

    renderBreathSprite(container, config, pov, getLevelName) {
      const currentLevel = config.currentLevel || config.level || 1;
      const character = config.pov || config.character || pov;

      const totalLevels = 50;
      const visibleRungs = 3;
      const rungHeight = 14;
      const innerHeight = 56;
      const innerWidth = 72;
      const borderWidth = 12;
      const outerHeight = innerHeight + (borderWidth * 3);
      const outerWidth = innerWidth + (borderWidth * 3);
      const containerHeight = 72;

      // Seeded random number generator
      function seededRandom(seed) {
        let x = Math.sin(seed++) * 10000;
        return x - Math.floor(x);
      }

      // Generate seed from character name
      function getCharacterSeed(name) {
        let hash = 0;
        for (let i = 0; i < name.length; i++) {
          hash = ((hash << 5) - hash) + name.charCodeAt(i);
          hash = hash & hash;
        }
        return Math.abs(hash);
      }

      const characterSeed = getCharacterSeed(character.toLowerCase());

      function getSeededColor(level) {
        const seed = characterSeed + level * 1000;
        const letters = '0123456789ABCDEF';
        let color = '#';
        for (let i = 0; i < 6; i++) {
          const randomValue = seededRandom(seed + i);
          color += letters[Math.floor(randomValue * 16)];
        }
        return color;
      }

      let rungs = '';
      for (let i = totalLevels; i >= 1; i--) {
        const levelName = getLevelName(character, i);
        const isCurrentLevel = i === currentLevel;
        const isFutureLevel = i > currentLevel;
        const isPastLevel = i <= currentLevel;

        let bgColor = '#000';
        let textColor = '#fff';

        if (isPastLevel) {
          bgColor = getSeededColor(i * 2);
          textColor = getSeededColor(i * 2 + 1);
        }

        rungs += `
          <div class="echeladder-rung ${isCurrentLevel ? 'current' : ''} ${isFutureLevel ? 'future' : ''}" data-level="${i}" title="${levelName}" style="height: ${rungHeight}px; display: flex; align-items: center; padding: 0 4px; background: ${bgColor}; color: ${textColor}; font-weight: bold; font-family: 'Courier New', monospace; border-bottom: 2px solid #4a92f7;">
            <span class="rung-name" style="font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; letter-spacing: -0.5px;">${levelName}</span>
          </div>
        `;
      }

      container.innerHTML = `
        <style>
          .echeladder-outer-frame {
            position: relative;
            background: #fff;
            border: ${borderWidth}px solid #4a92f7;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
          }
          .echeladder-outer-frame::before {
            content: 'ECHELADDER';
            position: absolute;
            top: -12px;
            left: 50%;
            transform: translateX(-50%);
            font-family: 'Courier New', monospace;
            font-size: 10px;
            font-weight: bold;
            color: #fff;
            background: #4a92f7;
            padding: 0 2px;
            line-height: ${borderWidth}px;
          }
          .echeladder-container::before {
            content: '';
            position: absolute;
            top: -5px;
            left: 8px;
            width: 90%;
            height: 5px;
            background: #c7e6ff;
            transform: skewX(-40deg);
            transform-origin: bottom left;
            z-index: 2;
          }
          .custom-scrollbar::before {
            content: '';
            position: absolute;
            top: -5px;
            width: 100%;
            height: 5px;
            background: #cfcfcf;
            transform: skewX(-40deg);
            transform-origin: bottom left;
            z-index: 2;
          }
          .echeladder-container::after {
            content: '';
            position: absolute;
            top: 0;
            right: -6px;
            width: 6px;
            height: 100%;
            background: #93d0ff;
            transform: skewY(-40deg);
            transform-origin: top left;
            z-index: 2;
          }

        </style>
        <div class="echeladder-outer-frame" style="width: ${outerWidth}px; height: ${outerHeight}px; position: relative; left: -${(outerWidth - 72) / 2 }px; top: -${(outerHeight - 72) / 2 + 4}px;">
          <div class="echeladder-container" style="height: ${innerHeight}px; width: ${innerWidth}px; position: relative; overflow: visible; background: #000; margin-top: 3px; margin-left: -4px; margin-top: 5px;">
            <div class="custom-scrollbar" style="position: absolute; left: 0; top: 0; bottom: 0; width: 10px; background: #f1f1ec; border-right: 2px solid #4a92f7; z-index: 1;">
              <button class="scrollbar-button scrollbar-up" style="width: 100%; height: 10px; background: #f1f1ec; border: none; color: #000; cursor: pointer; font-size: 6px; display: flex; align-items: center; justify-content: center; padding: 0;" aria-label="Scroll up">▲</button>
              <div class="scrollbar-track" style="position: relative; height: calc(100% - 20px); background: #f1f1ec;">
                <div class="scrollbar-thumb" style="position: absolute; width: 100%; background: #aac9eb; cursor: grab; border: 1px outset #6f89b0;"></div>
              </div>
              <button class="scrollbar-button scrollbar-down" style="width: 100%; height: 10px; background: #f1f1ec; border: none; color: #000; cursor: pointer; font-size: 6px; display: flex; align-items: center; justify-content: center; padding: 0;" aria-label="Scroll down">▼</button>
            </div>
            <div class="echeladder-content-wrapper" style="position: absolute; width: calc(100% - 10px); left: 10px; top: 0; bottom: 0; overflow: hidden; border: 2px solid #4a92f7; border-left: none;">
              <div class="echeladder-content" style="position: relative; width: 100%;">
                ${rungs}
              </div>
            </div>
          </div>
        </div>
      `;

      const echeladderContent = container.querySelector('.echeladder-content');
      const scrollbarThumb = container.querySelector('.scrollbar-thumb');
      const scrollbarTrack = container.querySelector('.scrollbar-track');
      const scrollUpBtn = container.querySelector('.scrollbar-up');
      const scrollDownBtn = container.querySelector('.scrollbar-down');
      const echeladderContainer = container.querySelector('.echeladder-container');

      const contentHeight = totalLevels * rungHeight;
      const scrollableHeight = contentHeight - innerHeight;
      const trackHeight = scrollbarTrack.clientHeight;
      const thumbHeight = Math.max(12, (innerHeight / contentHeight) * trackHeight * 0.7);
      scrollbarThumb.style.height = `${thumbHeight}px`;

      const currentRung = container.querySelector(`.echeladder-rung[data-level="${currentLevel}"]`);
      if (currentRung) {
        const scrollPosition = (totalLevels - currentLevel) * rungHeight - rungHeight;
        echeladderContent.style.top = `-${scrollPosition}px`;

        const thumbPosition = (scrollPosition / scrollableHeight) * (trackHeight - thumbHeight);
        scrollbarThumb.style.top = `${thumbPosition}px`;
      }

      function updateScroll(scrollTop) {
        scrollTop = Math.max(0, Math.min(scrollTop, scrollableHeight));
        echeladderContent.style.top = `-${scrollTop}px`;

        const thumbPosition = (scrollTop / scrollableHeight) * (trackHeight - thumbHeight);
        scrollbarThumb.style.top = `${thumbPosition}px`;
      }

      scrollUpBtn.addEventListener('click', () => {
        const currentScroll = Math.abs(parseInt(echeladderContent.style.top) || 0);
        updateScroll(currentScroll - rungHeight);
      });

      scrollDownBtn.addEventListener('click', () => {
        const currentScroll = Math.abs(parseInt(echeladderContent.style.top) || 0);
        updateScroll(currentScroll + rungHeight);
      });

      scrollUpBtn.addEventListener('mouseenter', () => {
        scrollUpBtn.style.background = '#ffffff';
      });
      scrollUpBtn.addEventListener('mouseleave', () => {
        scrollUpBtn.style.background = '#f1f1ec';
      });

      scrollDownBtn.addEventListener('mouseenter', () => {
        scrollDownBtn.style.background = '#ffffff';
      });
      scrollDownBtn.addEventListener('mouseleave', () => {
        scrollDownBtn.style.background = '#f1f1ec';
      });

      let isDragging = false;
      let startY = 0;
      let startThumbTop = 0;

      scrollbarThumb.addEventListener('mousedown', (e) => {
        isDragging = true;
        startY = e.clientY;
        startThumbTop = parseInt(scrollbarThumb.style.top) || 0;
        scrollbarThumb.style.cursor = 'grabbing';
        scrollbarThumb.style.border = '1px inset #6f89b0';
        e.preventDefault();
      });

      scrollbarThumb.addEventListener('mouseenter', () => {
        if (!isDragging) {
          scrollbarThumb.style.background = '#c0e0ff';
        }
      });

      scrollbarThumb.addEventListener('mouseleave', () => {
        if (!isDragging) {
          scrollbarThumb.style.background = '#aac9eb';
        }
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDragging) return;

        const deltaY = e.clientY - startY;
        const newThumbTop = Math.max(0, Math.min(startThumbTop + deltaY, trackHeight - thumbHeight));
        scrollbarThumb.style.top = `${newThumbTop}px`;

        const scrollRatio = newThumbTop / (trackHeight - thumbHeight);
        const newScrollTop = scrollRatio * scrollableHeight;
        echeladderContent.style.top = `-${newScrollTop}px`;
      });

      document.addEventListener('mouseup', () => {
        if (isDragging) {
          isDragging = false;
          scrollbarThumb.style.cursor = 'grab';
          scrollbarThumb.style.border = '1px outset #6f89b0';
          scrollbarThumb.style.background = '#aac9eb';
        }
      });

      echeladderContainer.addEventListener('wheel', (e) => {
        e.preventDefault();
        const currentScroll = Math.abs(parseInt(echeladderContent.style.top) || 0);
        const delta = e.deltaY > 0 ? rungHeight : -rungHeight;
        updateScroll(currentScroll + delta);
      });
    },

    renderGodTierSprite(container, config) {
      console.log('Rendering god tier symbol for:', config);
      const aspectName = config.aspect.toLowerCase();
      container.innerHTML = `
        <img src="/images/aspects/${aspectName}.svg" alt="${config.aspect} aspect" style="width: 72px; height: 72px;" title="${config.characterName} - ${config.class} of ${config.aspect}" />
      `;
    },

    renderHealthBarSprite(container, config) {
      console.log('Rendering health bar:', config);
      const percentage = Math.max(0, Math.min(100, (config.currentHealth / config.maxHealth) * 100));

      container.innerHTML = `
        <div style="width: 72px; height: 72px; display: flex; flex-direction: column; align-items: center; justify-content: center;">
          <svg width="72" height="72" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg">
            <circle cx="36" cy="36" r="30" fill="none" stroke="#333" stroke-width="4"/>
            <circle cx="36" cy="36" r="30" fill="none" stroke="#72EB34" stroke-width="4"
              stroke-dasharray="${2 * Math.PI * 30}"
              stroke-dashoffset="${2 * Math.PI * 30 * (1 - percentage / 100)}"
              transform="rotate(-90 36 36)"
              stroke-linecap="round"/>
            ${config.showNumbers !== false ? `<text x="36" y="40" text-anchor="middle" font-size="10" font-weight="bold" fill="#72EB34" font-family="monospace">${config.currentHealth}/${config.maxHealth}</text>` : ''}
          </svg>
        </div>
      `;
    },

    renderGristSprite(container, config, pov, gristOrder, gristIconPaths, setPageGrist, getCharacterGristAtPage, initGristCounter) {
      console.log('Rendering grist counter:', config);

      const character = config.character || pov;

      if (config.deltas && Object.keys(config.deltas).length > 0) {
        setPageGrist(character, config.pageNumber, config.deltas);
      }

      const inventory = getCharacterGristAtPage(character, config.pageNumber);

      const availableGrists = gristOrder.filter(gristType => inventory[gristType] && inventory[gristType] > 0);

      if (availableGrists.length === 0) {
        container.innerHTML = '';
        return;
      }

      const gristHTML = availableGrists.map((gristType, index) => {
        const amount = inventory[gristType];
        const iconPath = gristIconPaths[gristType];
        return `
          <div class="grist-item" data-index="${index}" data-grist="${gristType}">
            <img src="${iconPath}" alt="${gristType}" class="grist-icon" />
            <span class="grist-amount">${amount}</span>
          </div>
        `;
      }).join('');

      container.innerHTML = `
        <div class="grist-counter" id="grist-counter">
          <div class="grist-list" id="grist-list">
            ${gristHTML}
          </div>
        </div>
      `;

      requestAnimationFrame(() => {
        initGristCounter(availableGrists.length);
      });
    }
  };
</script>
