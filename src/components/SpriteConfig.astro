/**
 * SpriteConfig.astro
 *
 * Define sprite configurations for each page and aspect theme.
 * Each page can have different sprite configurations per aspect.
 *
 * AVAILABLE ASPECTS:
 * space, breath, light, time, heart, mind, hope, rage, life, doom, blood, void
 *
 * SPRITE TYPES:
 * - 'clock': Animated clock with configurable behavior (time aspect)
 * - 'tooltip': Shows aspect icon with hover tooltip (mind, light aspects)
 * - 'level': Character level/rank indicator (breath aspect)
 * - 'quadrant': Relationship quadrant display (blood aspect)
 * - 'specibus': Weapon type display (rage aspect)
 * - 'inventory': Captchalogue system (doom aspect)
 * - 'health': Health bar (life aspect)
 * - 'emotion': Mood/emotion indicator (heart aspect)
 * - 'godtier': God tier symbols (hope aspect)
 * - 'hidden': Hidden metadata storage (void aspect)
 * - 'static': Static SVG image (space and other aspects)
 *
 * ===== TIME ASPECT (Clock) =====
 * See src/sprites/time.ts for detailed documentation on:
 * - Modes: 'default' (UTC), 'loop', 'final'
 * - Time values: 'HH:MM:SS', 'random', '= X' (pause), '+ X' (relative), '> X' (jump), 'NaN' (hide hands)
 * - Date values: 'YYYY:MM:DD', 'random', '= X' (pause), '+ X' (relative), '> X' (jump), 'NaN' (hide date)
 * - Speed multiplier
 * - Triggers: 'automatic', 'click', 'game'
 *
 * Examples:
 *   time: timeSprite  // Default UTC clock with current date
 *   time: createTimeConfig('loop', '12:30:50', '12:30:59', { middleTimes: ['+ 5'], speed: 1 })
 *   time: createTimeConfig('loop', '08:00:00', '17:00:00', { trigger: 'click' })
 *   time: createTimeConfig('loop', '00:00:00', '23:59:59', {
 *     startDate: '2009:04:13',
 *     endDate: '+ 1',
 *     middleTimes: ['+ 43200'],
 *     middleDates: ['+ 0']
 *   })
 *
 * ===== SPACE ASPECT (Static Images) =====
 * See src/sprites/space.ts for available images:
 * - 'Derse', 'Prospit', 'Skaia'
 * - 'LOXAY1' through 'LOXAY9' (9 different lands)
 * - 'NaN' (black circle, default)
 *
 * Examples:
 *   space: createSpaceConfig('Derse')
 *   space: createSpaceConfig('LOXAY3')
 *
 * ===== MIND ASPECT (Tooltip) =====
 * Shows the mind aspect icon with mental state text on hover (1-3 words)
 *
 * Examples:
 *   mind: createMindConfig('thinking...')
 *   mind: createMindConfig('confused')
 *   mind: createMindConfig('focused')
 *
 * ===== LIGHT ASPECT (Tooltip) =====
 * Shows the light aspect icon with hidden fact/meta-state on hover
 *
 * Examples:
 *   light: createLightConfig('This character knows the truth')
 *   light: createLightConfig('Hidden knowledge revealed')
 *
 * ===== BREATH ASPECT (Level Indicator) =====
 * Character level/rank progression display
 *
 * Examples:
 *   breath: createBreathConfig(5, 10)  // Level 5 of 10
 *   breath: createBreathConfig(3, 10, 'Novice')  // Level 3 with name
 *
 * ===== BLOOD ASPECT (Quadrant) =====
 * Relationship quadrant indicator from external card suit icons
 * Available quadrants: heart, diamond, spade, club, none
 *
 * Examples:
 *   blood: await createBloodConfig('heart')
 *   blood: await createBloodConfig('diamond', 'Rose')  // With target name
 *
 * ===== RAGE ASPECT (Specibus) =====
 * Strife specibus (weapon type) display from external icons
 * Available weapons: sword, hammer, spear, bow, axe, mace, staff, dagger
 *
 * Examples:
 *   rage: await createRageConfig('sword')
 *   rage: await createRageConfig('hammer', 'Zillyhoo')  // With weapon name
 *
 * ===== DOOM ASPECT (Inventory) =====
 * Inventory/captchalogue system display
 *
 * Examples:
 *   doom: createDoomConfig([{ name: 'Apple', code: 'APPLE' }], 8)
 *   doom: createDoomConfig([{ name: 'Sword' }, { name: 'Shield' }])
 *
 * ===== LIFE ASPECT (Health Bar) =====
 * Health bar display with optional numbers
 *
 * Examples:
 *   life: createLifeConfig(75, 100)  // 75/100 HP
 *   life: createLifeConfig(50, 100, false)  // No numbers shown
 *
 * ===== HEART ASPECT (Emotion) =====
 * Mood/emotion indicator with intensity
 *
 * Examples:
 *   heart: createHeartConfig('happy', 8)
 *   heart: createHeartConfig('determined', 10)
 *
 * ===== HOPE ASPECT (God Tier) =====
 * God tier symbols per character
 *
 * Examples:
 *   hope: createHopeConfig('John', 'breath', 'heir')
 *   hope: createHopeConfig('Rose', 'light', 'seer')
 *
 * ===== VOID ASPECT (Hidden) =====
 * Hidden metadata storage (not displayed, for secrets)
 *
 * Examples:
 *   void: createVoidConfig({ secret: 'hidden value', flag: true })
 */

