/**
 * SpriteConfig.astro
 *
 * Define sprite configurations for each page and aspect theme.
 * Each page can have different sprite configurations per aspect.
 *
 * AVAILABLE ASPECTS:
 * space, breath, light, time, heart, mind, hope, rage, life, doom, blood, void
 *
 * SPRITE TYPES:
 * - 'clock': Animated clock with configurable behavior (time aspect)
 * - 'tooltip': Shows aspect icon with hover tooltip (mind, light aspects)
 * - 'level': Character level/rank indicator (breath aspect)
 * - 'quadrant': Relationship quadrant display (blood aspect)
 * - 'specibus': Weapon type display (rage aspect)
 * - 'inventory': Captchalogue system (doom aspect)
 * - 'health': Health bar (life aspect)
 * - 'emotion': Mood/emotion indicator (heart aspect)
 * - 'godtier': God tier symbols (hope aspect)
 * - 'hidden': Hidden metadata storage (void aspect)
 * - 'static': Static SVG image (space and other aspects)
 *
 * ===== TIME ASPECT (Clock) =====
 * See src/sprites/time.ts for detailed documentation on:
 * - Modes: 'default' (UTC), 'loop', 'final'
 * - Time values: 'HH:MM:SS', 'random', '= X' (pause), '+ X' (relative), '> X' (jump), 'NaN' (hide hands)
 * - Date values: 'YYYY:MM:DD', 'random', '= X' (pause), '+ X' (relative), '> X' (jump), 'NaN' (hide date)
 * - Speed multiplier
 * - Triggers: 'automatic', 'click', 'game'
 *
 * Examples:
 *   time: timeSprite  // Default UTC clock with current date
 *   time: createTimeConfig('loop', '12:30:50', '12:30:59', { middleTimes: ['+ 5'], speed: 1 })
 *   time: createTimeConfig('loop', '08:00:00', '17:00:00', { trigger: 'click' })
 *   time: createTimeConfig('loop', '00:00:00', '23:59:59', {
 *     startDate: '2009:04:13',
 *     endDate: '+ 1',
 *     middleTimes: ['+ 43200'],
 *     middleDates: ['+ 0']
 *   })
 *
 * ===== SPACE ASPECT (Static Images) =====
 * See src/sprites/space.ts for available images:
 * - 'Derse', 'Prospit', 'Skaia'
 * - 'LOXAY1' through 'LOXAY9' (9 different lands)
 * - 'NaN' (black circle, default)
 *
 * Examples:
 *   space: createSpaceConfig('Derse')
 *   space: createSpaceConfig('LOXAY3')
 *
 * ===== MIND ASPECT (Tooltip) =====
 * Shows the mind aspect icon with mental state text on hover (1-3 words)
 *
 * Examples:
 *   mind: createMindConfig('thinking...')
 *   mind: createMindConfig('confused')
 *   mind: createMindConfig('focused')
 *
 * ===== LIGHT ASPECT (Character Icons) =====
 * Shows character icon with tooltip on hover (only visible on light theme)
 * Uses POV character automatically, only message needs to be specified
 *
 * Examples:
 *   light: createLightConfig('Alexis appears')
 *   light: createLightConfig('A mysterious figure emerges')
 *
 * ===== BREATH ASPECT (Echeladder) =====
 * Character level/rank progression display (50 levels total)
 * Shows a scrollable ladder with 3 visible rungs at a time
 * Level names are POV-specific and automatically determined
 *
 * The breath aspect automatically uses the page's POV character.
 * If you don't specify a breath config, it will use the last known level for that POV.
 * Only specify breath when you want to change the level.
 *
 * Examples:
 *   breath: createBreathConfig(5)  // Set POV character to level 5
 *   // No breath config = use last known level for this POV
 *   breath: createBreathConfig(10, 'irene')  // Override: set Irene to level 10
 *
 * ===== HEART ASPECT (Quadrant) =====
 * Relationship quadrant indicator from external card suit icons
 * Available quadrants: heart, diamond, spade, club, none
 *
 * Examples:
 *   heart: await createHeartConfig('heart')
 *   heart: await createHeartConfig('diamond', 'Rose')  // With target name
 *
 * ===== RAGE ASPECT (Specibus) =====
 * Strife specibus (weapon type) display from external icons
 * Uses POV character's weapon automatically
 *
 * Examples:
 *   rage: createRageConfig()  // Uses POV character's weapon
 *   rage: createRageConfig('Zillyhoo')  // With custom weapon name
 *
 * ===== DOOM ASPECT (Inventory) =====
 * Inventory/captchalogue system display
 * Uses POV character's inventory automatically
 *
 * Examples:
 *   doom: createDoomConfig([{ name: 'Apple', code: 'APPLE' }], 8)
 *   doom: createDoomConfig([{ name: 'Sword' }, { name: 'Shield' }])
 *
 * ===== LIFE ASPECT (Health Bar) =====
 * Health bar display with optional numbers
 *
 * Examples:
 *   life: createLifeConfig(75, 100)  // 75/100 HP
 *   life: createLifeConfig(50, 100, false)  // No numbers shown
 *
 * ===== BLOOD ASPECT (Grist Counter) =====
 * Grist counter display showing character inventory with page-based deltas
 * Uses POV character automatically unless overridden
 * Available grist types: Build, Amber, Amethyst, Artifact, Caulk, Chalk, Cobalt, Diamond,
 *                        Garnet, Gold, Iodine, Marble, Mercury, Quartz, Ruby, Rust, Shale,
 *                        Sulfur, Tar, Uranium, Zillium
 *
 * The system tracks inventory by adding/subtracting deltas across pages.
 * Only grists with non-zero amounts are displayed.
 *
 * Examples:
 *   blood: createBloodConfig(1, { 'Build': 10, 'Amber': 5 })  // Uses POV character
 *   blood: createBloodConfig(2, { 'Build': -5 })  // Page 2: POV has 5 Build, 5 Amber
 *   blood: createBloodConfig(1, { 'Build': 20 }, 'victor')  // Override with specific character
 *
 * ===== HOPE ASPECT (God Tier) =====
 * God tier symbols per character
 *
 * Examples:
 *   hope: createHopeConfig('John', 'breath', 'heir')
 *   hope: createHopeConfig('Rose', 'light', 'seer')
 *
 * ===== VOID ASPECT (Hidden) =====
 * Hidden metadata storage (not displayed, for secrets)
 * Messages are logged to the browser console when the page loads
 * Examples:
 *   void: createVoidConfig({ secret: 'hidden value', flag: true }, 'This is a hidden message')
 *   void: createVoidConfig({ page: 1 }, 'The journey begins in silence.')
 */

import { defaultSprite } from '../sprites/default';
import { spaceSprite, createSpaceConfig } from '../sprites/space';
import { breathSprite, createBreathConfig, setCharacterLevel, getCharacterLevel } from '../sprites/breath';
import { lightSprite, createLightConfig } from '../sprites/light';
import { timeSprite, createTimeConfig } from '../sprites/time';
import { heartSprite, createHeartConfig } from '../sprites/heart';
import { mindSprite, createMindConfig } from '../sprites/mind';
import { hopeSprite, createHopeConfig } from '../sprites/hope';
import { rageSprite, createRageConfig } from '../sprites/rage';
import { lifeSprite, createLifeConfig } from '../sprites/life';
import { doomSprite, createDoomConfig } from '../sprites/doom';
import { bloodSprite, createBloodConfig } from '../sprites/blood';
import { voidSprite, createVoidConfig } from '../sprites/void';

export interface ClockConfig {
  type: 'clock';
  mode: 'default' | 'loop' | 'final';
  startTime?: string;
  middleTimes?: string[];
  endTime?: string;
  speed?: number;
  startDate?: string;
  middleDates?: string[];
  endDate?: string;
  trigger?: 'automatic' | 'click' | 'game';
}

export interface StaticConfig {
  type: 'static';
  svg: string;
}

export type SpriteConfig = ClockConfig | StaticConfig | any;

/**
