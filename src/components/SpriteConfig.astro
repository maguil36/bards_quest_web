      blood: createBloodConfig(20, { 'Build': 50, 'Amethyst': 10 }),
      void: createVoidConfig({ page: 20 }, 'The end is just another beginning hidden in shadow.')
    }
  };

  // Post-process breath configs in two passes
  // Pass 1: Set all explicit levels
  for (const [pageNum, config] of Object.entries(configs)) {
    if (config.breath && config.pov) {
      const pov = config.pov.toLowerCase();
      if (!config.breath.pov) {
        config.breath.pov = pov;
      }
      setCharacterLevel(config.breath.pov, config.breath.currentLevel);
    }
  }

  // Pass 2: Fill in missing breath configs with last known levels
  for (const [pageNum, config] of Object.entries(configs)) {
    if (config.pov && !config.breath) {
      const pov = config.pov.toLowerCase();
      const lastLevel = getCharacterLevel(pov);
      config.breath = createBreathConfig(lastLevel, pov);
    }
  }

  return configs;
})();

/**
 * Default fallback configuration for pages not explicitly defined (e.g., non-webcomic pages)
 */
export const defaultPageConfig: Record<string, any> = await (async () => ({
  pov: 'redacted',
  time: createTimeConfig('default'),
  space: createSpaceConfig('Earth'),
  breath: createBreathConfig(1),
  light: createLightConfig('Unknown'),
  heart: await createHeartConfig('none'),
  mind: createMindConfig('neutral'),
  hope: createHopeConfig(),
  rage: createRageConfig(),
  life: createLifeConfig(100, 100),
  doom: createDoomConfig([]),
  blood: createBloodConfig(0, {}),
  void: createVoidConfig({ default: true }, '')
}))();

/**
 * Default fallback configuration for aspects not defined in page configs
 */
const defaultConfig: SpriteConfig = {
  type: 'static',
  svg: defaultSprite
};

/**
 * Get sprite configuration for a specific page and aspect.
 */
export function getSpriteConfig(page: number, aspect: string): SpriteConfig {
  return pageConfigs[page]?.[aspect] || defaultPageConfig[aspect] || defaultConfig;
}
