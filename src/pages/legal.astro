---
import MSPALayout from '../layouts/MSPALayout.astro';
const canonical = Astro.site ? new URL('/legal', Astro.site).toString() : undefined;
---
<MSPALayout title="Legal" description="Legal information and terms." canonical={canonical} page={0}>
  <h1>Legal</h1>
  <p>Bards quest doesn't own any of the IP from homestuck. Bards quest simply is taking concepts from the original web comic. Please read the original comic.</p>
  <div class="ctas">
    <a href="/" class="cta">&gt; Return Home.</a>
    <a href="/map" class="cta">&gt; Explore the Map.</a>
  </div>
</MSPALayout>
